<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:gravity="center_vertical">

    <CheckBox
        android:id="@+id/macro_checkbox_field"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp" />

    <EditText
        android:id="@+id/macro_edit_field"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="your macro here"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="16sp"
        android:textColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="2dp">

        <ImageView
            android:id="@+id/macro_move_up"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitEnd"
            android:src="@android:drawable/arrow_up_float"
            android:contentDescription="Move up"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginBottom="2dp" />

        <ImageView
            android:layout_marginTop="2dp"
            android:id="@+id/macro_move_down"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitStart"
            android:src="@android:drawable/arrow_down_float"
            android:contentDescription="Move down"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

</LinearLayout>

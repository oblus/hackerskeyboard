<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/main_setup_btn_configure_imes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="@string/main_setup_configure_imes" />

            <Button
                android:id="@+id/main_setup_btn_input_lang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="@string/main_setup_input_lang" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/main_setup_btn_set_ime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="@string/main_setup_set_ime" />

            <Button
                android:id="@+id/main_setup_btn_get_dicts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="@string/main_setup_get_dicts" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/main_setup_btn_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="@string/main_setup_settings" />

            <Button
                android:id="@+id/main_setup_btn_ui_language"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="@string/main_setup_ui_language" />
        </LinearLayout>

        <TextView
            android:id="@+id/main_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="10sp"
            tools:ignore="SmallSp" />

        <EditText
            android:id="@+id/main_setup_edit_test_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_text"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_password"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_email"
            android:inputType="textEmailAddress"
            android:imeOptions="actionSend"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_uri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_uri"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_number"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_phone"
            android:inputType="phone"
            android:imeOptions="actionDone"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_short_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_short_message"
            android:inputType="textShortMessage"
            android:imeOptions="actionSend"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_long_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_long_message"
            android:inputType="textLongMessage"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_no_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_no_suggestions"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_cap_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_cap_words"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_datetime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_datetime"
            android:inputType="datetime"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_date"
            android:inputType="date"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_time"
            android:inputType="time"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_visible_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_visible_password"
            android:inputType="textVisiblePassword"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_number_signed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_number_signed"
            android:inputType="numberSigned"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_number_decimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_number_decimal"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_number_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_number_password"
            android:inputType="numberPassword"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_postal_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_postal_address"
            android:inputType="textPostalAddress"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_person_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_person_name"
            android:inputType="textPersonName"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_filter"
            android:inputType="textFilter"
            android:imeOptions="actionSearch"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_web_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_web_edit_text"
            android:inputType="textWebEditText"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_phonetic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_phonetic"
            android:inputType="textPhonetic"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_email_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_email_subject"
            android:inputType="textEmailSubject"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_cap_characters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_cap_characters"
            android:inputType="textCapCharacters"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_cap_sentences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_cap_sentences"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_auto_correct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_auto_correct"
            android:inputType="textAutoCorrect"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_auto_complete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_auto_complete"
            android:inputType="textAutoComplete"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_multi_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_multi_line"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/main_setup_edit_test_ime_multi_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_ime_multi_line"
            android:inputType="textImeMultiLine"
            android:imeOptions="actionNext" />

        <EditText
            android:id="@+id/main_setup_edit_test_web_email_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_web_email_address"
            android:inputType="textWebEmailAddress"
            android:maxLines="1" />

        <EditText
            android:id="@+id/main_setup_edit_test_web_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/main_setup_test_web_password"
            android:inputType="textWebPassword"
            android:imeOptions="actionDone"
            android:maxLines="1" />
    </LinearLayout>
</ScrollView>

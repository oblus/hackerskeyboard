<Keyboard
    xmlns:android="http://schemas.android.com/apk/res/android" xmlns:hk="http://schemas.android.com/apk/res-auto"
    hk:keyWidth="10%p"
    hk:horizontalGap="0px"
    hk:verticalGap="@dimen/key_bottom_gap"
>
    <Row
        hk:rowEdgeFlags="top"
    >
        <Key
            hk:keyLabel="1"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="¹½⅓¼⅛"
            hk:keyEdgeFlags="left" />
        <Key
            hk:keyLabel="2"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="²⅔" />
        <Key
            hk:keyLabel="3"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="³¾⅜" />
        <Key
            hk:keyLabel="4"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="⁴" />
        <Key
            hk:keyLabel="5"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="⅝" />
        <Key
            hk:keyLabel="6" />
        <Key
            hk:keyLabel="7"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="⅞" />
        <Key
            hk:keyLabel="8" />
        <Key
            hk:keyLabel="9" />
        <Key
            hk:keyLabel="0"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="ⁿ∅"
            hk:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            hk:keyLabel="\@"
            hk:keyEdgeFlags="left" />
        <Key
            hk:keyLabel="\#" />
        <Key
            hk:keyLabel="$"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="¢£€¥₣₤₱" />
        <Key
            hk:keyLabel="%"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="‰" />
        <Key
            hk:keyLabel="&amp;" />
        <Key
            hk:keyLabel="*"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="†‡★" />
        <Key
            hk:keyLabel="-"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="_–—" />
        <Key
            hk:keyLabel="+"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="±" />
        <Key
            hk:keyLabel="("
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="[{&lt;" />
        <Key
            hk:keyLabel=")"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="]}&gt;"
            hk:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            hk:codes="@integer/key_shift"
            hk:keyLabel="@string/label_alt_key"
            hk:keyWidth="15%p"
            hk:isModifier="true"
            hk:isSticky="true"
            hk:keyEdgeFlags="left" />
        <Key
            hk:keyLabel="!"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="¡" />
        <Key
            hk:keyLabel="&quot;"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="“”«»˝" />
        <Key
            hk:keyLabel="\'"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="‘’" />
        <Key
            hk:keyLabel=":" />
        <Key
            hk:keyLabel=";" />
        <Key
            hk:keyLabel="/" />
        <Key
            hk:keyLabel="\?"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="¿" />
        <Key
            hk:codes="@integer/key_delete"
            hk:keyIcon="@drawable/sym_keyboard_delete"
            hk:iconPreview="@drawable/sym_keyboard_feedback_delete"
            hk:keyWidth="15%p"
            hk:isModifier="true"
            hk:isRepeatable="true"
            hk:keyEdgeFlags="right" />
    </Row>
    <Row
        hk:keyboardMode="@+id/mode_symbols"
        hk:rowEdgeFlags="bottom"
    >
        <Key
            hk:codes="@integer/key_symbol"
            hk:keyLabel="@string/label_alpha_key"
            hk:keyWidth="20%p"
            hk:isModifier="true"
            hk:keyEdgeFlags="left" />
        <Key
            hk:codes="@integer/key_f1"
            hk:isModifier="true" />
        <Key
            hk:codes="@integer/key_space"
            hk:keyIcon="@drawable/sym_keyboard_space"
            hk:iconPreview="@drawable/sym_keyboard_feedback_space"
            hk:keyWidth="40%p"
            hk:isModifier="true" />
        <Key
            hk:keyLabel="."
            hk:keyIcon="@drawable/hint_popup"
            hk:popupKeyboard="@xml/popup_punctuation"
            hk:isModifier="true" />
        <Key
            hk:codes="@integer/key_return"
            hk:keyIcon="@drawable/sym_keyboard_return"
            hk:iconPreview="@drawable/sym_keyboard_feedback_return"
            hk:keyWidth="20%p"
            hk:isModifier="true"
            hk:keyEdgeFlags="right" />
    </Row>
    <Row

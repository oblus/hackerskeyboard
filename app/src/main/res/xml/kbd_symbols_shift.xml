<Keyboard
    xmlns:android="http://schemas.android.com/apk/res/android" xmlns:hk="http://schemas.android.com/apk/res-auto"
    hk:keyWidth="10%p"
    hk:horizontalGap="0px"
    hk:verticalGap="@dimen/key_bottom_gap"
>
    <Row
        hk:rowEdgeFlags="top"
    >
        <Key
            hk:keyLabel="~"
            hk:keyEdgeFlags="left" />
        <Key
            hk:keyLabel="`" />
        <Key
            hk:keyLabel="|" />
        <Key
            hk:keyLabel="•"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="♪♥♠♦♣" />
        <Key
            hk:keyLabel="√" />
        <Key
            hk:keyLabel="π"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="Π" />
        <Key
            hk:keyLabel="÷" />
        <Key
            hk:keyLabel="×" />
        <Key
            hk:keyLabel="{" />
        <Key
            hk:keyLabel="}"
            hk:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            hk:codes="@integer/key_tab"
            hk:keyLabel="\u21E5"
            hk:keyEdgeFlags="left" />
        <Key
            hk:keyLabel="£" />
        <Key
            hk:keyLabel="¢" />
        <Key
            hk:keyLabel="€" />
        <Key
            hk:keyLabel="°" />
        <Key
            hk:keyLabel="^"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="↑↓←→" />
        <Key
            hk:keyLabel="_" />
        <Key
            hk:keyLabel="="
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="≠≈∞" />
        <Key
            hk:keyLabel="[" />
        <Key
            hk:keyLabel="]"
            hk:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            hk:codes="@integer/key_shift"
            hk:keyLabel="@string/label_alt_key"
            hk:keyWidth="15%p"
            hk:isModifier="true"
            hk:isSticky="true"
            hk:keyEdgeFlags="left" />
        <Key
            hk:keyLabel="™" />
        <Key
            hk:keyLabel="®" />
        <Key
            hk:keyLabel="©" />
        <Key
            hk:keyLabel="¶"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="§" />
        <Key
            hk:keyLabel="\\" />
        <Key
            hk:keyLabel="&lt;"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="≤«‹" />
        <Key
            hk:keyLabel="&gt;"
            hk:popupKeyboard="@xml/kbd_popup_template"
            hk:popupCharacters="≥»›" />
        <Key
            hk:codes="@integer/key_delete"
            hk:keyIcon="@drawable/sym_keyboard_delete"
            hk:iconPreview="@drawable/sym_keyboard_feedback_delete"
            hk:keyWidth="15%p"
            hk:isModifier="true"
            hk:isRepeatable="true"
            hk:keyEdgeFlags="right" />
    </Row>
    <Row
        hk:keyboardMode="@+id/mode_symbols"
        hk:rowEdgeFlags="bottom"
    >
        <Key
            hk:codes="@integer/key_symbol"
            hk:keyLabel="@string/label_alpha_key"
            hk:keyWidth="20%p"
            hk:isModifier="true"
            hk:keyEdgeFlags="left" />
        <Key
            hk:keyLabel="„"
            hk:isModifier="true" />
        <Key
            hk:codes="@integer/key_space"
            hk:keyIcon="@drawable/sym_keyboard_space"
            hk:iconPreview="@drawable/sym_keyboard_feedback_space"
            hk:keyWidth="40%p"
            hk:isModifier="true" />
        <Key
            hk:keyLabel="…"
            hk:isModifier="true" />
        <Key
            hk:codes="@integer/key_return"
            hk:keyIcon="@drawable/sym_keyboard_return"
            hk:iconPreview="@drawable/sym_keyboard_feedback_return"
            hk:keyWidth="20%p"
            hk:isModifier="true"
            hk:keyEdgeFlags="right" />
    </Row>
    <Row
        hk:keyboardMode="@+id/mode_symbols_with_settings_key"
        hk:rowEdgeFlags="bottom"
    >
        <Key
            hk:codes="@integer/key_symbol"
            hk:keyLabel="@string/label_alpha_key"
            hk:keyWidth="15%p"
            hk:isModifier="true"
            hk:keyEdgeFlags="left" />
        <Key
            hk:codes="@integer/key_settings"
            hk:keyIcon="@drawable/sym_keyboard_settings"
            hk:iconPreview="@drawable/sym_keyboard_feedback_settings"
            hk:isModifier="true" />
        <Key
            hk:keyLabel="„"
            hk:isModifier="true" />
        <Key
            hk:codes="@integer/key_space"
            hk:keyIcon="@drawable/sym_keyboard_space"
            hk:iconPreview="@drawable/sym_keyboard_feedback_space"
            hk:keyWidth="30%p"
            hk:isModifier="true" />
        <Key
            hk:keyLabel="…"
            hk:isModifier="true" />
        <Key
            hk:codes="@integer/key_return"
            hk:keyIcon="@drawable/sym_keyboard_return"
            hk:iconPreview="@drawable/sym_keyboard_feedback_return"
            hk:keyWidth="25%p"
            hk:isModifier="true"
            hk:keyEdgeFlags="right" />
    </Row>
</Keyboard>

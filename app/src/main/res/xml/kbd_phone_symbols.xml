<Keyboard
    xmlns:android="http://schemas.android.com/apk/res/android" xmlns:hk="http://schemas.android.com/apk/res-auto"
    hk:keyWidth="26.67%p"
    hk:horizontalGap="0px"
    hk:verticalGap="@dimen/key_bottom_gap"
>
    <Row
        hk:rowEdgeFlags="top"
    >
        <Key
            hk:keyLabel="("
            hk:keyEdgeFlags="left" />
        <Key
            hk:keyLabel="/" />
        <Key
            hk:keyLabel=")" />
        <Key
            hk:keyLabel="-"
            hk:keyWidth="20%p"
            hk:isModifier="true"
            hk:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            hk:keyLabel="N"
            hk:keyEdgeFlags="left" />
        <!-- Pause is a comma. Check PhoneNumberUtils.java to see if this 
            has changed. -->
        <Key
            hk:codes="44"
            hk:keyLabel="Pause" />
        <Key
            hk:keyLabel="," />
        <Key
            hk:keyLabel="."
            hk:keyWidth="20%p"
            hk:isModifier="true"
            hk:keyEdgeFlags="right" />
    </Row>
    <Row>
        <Key
            hk:codes="42"
            hk:keyIcon="@drawable/sym_keyboard_numstar"
            hk:keyEdgeFlags="left" />
        <!-- Wait is a semicolon. -->
        <Key
            hk:codes="59"
            hk:keyLabel="Wait" />
        <Key
            hk:codes="35"
            hk:keyIcon="@drawable/sym_keyboard_numpound" />
        <Key
            hk:codes="@integer/key_delete"
            hk:keyIcon="@drawable/sym_keyboard_delete"
            hk:iconPreview="@drawable/sym_keyboard_feedback_delete"
            hk:keyWidth="20%p"
            hk:isModifier="true"
            hk:isRepeatable="true"
            hk:keyEdgeFlags="right" />
    </Row>
    <Row
        hk:rowEdgeFlags="bottom"
    >
        <Key
            hk:codes="@integer/key_symbol"
            hk:keyLabel="@string/label_phone_key"
            hk:keyEdgeFlags="left" />
        <Key
            hk:keyLabel="+" />
        <Key
            hk:codes="@integer/key_space"
            hk:keyIcon="@drawable/sym_keyboard_space"
            hk:iconPreview="@drawable/sym_keyboard_feedback_space" />
        <Key
            hk:codes="@integer/key_return"
            hk:keyIcon="@drawable/sym_keyboard_return"
            hk:keyWidth="20%p"
            hk:isModifier="true"
            hk:keyEdgeFlags="right" />
    </Row>
</Keyboard>
